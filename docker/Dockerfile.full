FROM python:3.11-slim-trixie@sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff
ARG VERSION

# Install core dependencies first
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
        mlflow[auth] \
        azure-identity \
        azure-storage-blob \
        msal \
        python-jose \
        cryptography \
        pyyaml \
        requests \
        psycopg[binary]

# Overlay the custom Azure SSO auth modules onto the installed mlflow package.
# These files are not part of the PyPI `mlflow` distribution, so without this
# step `mlflow.server.auth.azure_auth` is missing and the server fails at
# startup with ModuleNotFoundError. Requires the build context to be the repo
# root (see .github/workflows/build-full-image.yml).
COPY mlflow/server/auth/azure_auth.py \
     mlflow/server/auth/azure_auth_groups.py \
     mlflow/server/auth/azure_auth_groups_flexible.py \
     mlflow/server/auth/azure_auth_selector.py \
     /tmp/custom_auth/

RUN AUTH_DIR="$(python -c 'import mlflow.server.auth, os; print(os.path.dirname(mlflow.server.auth.__file__))')" && \
    cp /tmp/custom_auth/*.py "$AUTH_DIR/" && \
    rm -rf /tmp/custom_auth && \
    python -c "import mlflow.server.auth.azure_auth as m; print('azure_auth import OK:', m.__file__)"
